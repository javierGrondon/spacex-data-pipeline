# Copiá este archivo como .env y completá tus datos.

# --- Alertas por email (Gmail) ---
# 1. Activá la verificación en 2 pasos en tu cuenta de Google
# 2. Creá una "Contraseña de aplicación": https://myaccount.google.com/apppasswords
# 3. Pegala en SMTP_PASSWORD (16 caracteres, sin espacios)
# Si dejás esto vacío, el pipeline corre igual y las alertas solo quedan en el log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=tu_email@gmail.com

# --- Datos ---
# true = usa los datos de muestra del repo (sirve si la API de SpaceX no responde)
USE_SAMPLE_DATA=false

# Linux/Mac: poné el resultado de `id -u` (en Windows dejalo así)
AIRFLOW_UID=50000
